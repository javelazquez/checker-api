# ============================================
# Configuración del Ambiente
# ============================================
# Ambiente de ejecución: local, development, staging, production
# Si es "local" o está vacío, se cargarán las variables desde este archivo .env
# Para otros ambientes, las variables deben estar en el sistema operativo
ENV=LOCAL
# Alternativamente puedes usar:
# ENVIRONMENT=local

# ============================================
# Configuración del Servidor HTTP
# ============================================
# Puerto donde el servidor HTTP escuchará
SERVER_PORT=8080

# Timeout de lectura (tiempo máximo para leer el cuerpo completo de la petición)
SERVER_READ_TIMEOUT=15s

# Timeout de escritura (tiempo máximo antes de cancelar la escritura de la respuesta)
SERVER_WRITE_TIMEOUT=15s

# Timeout de idle (tiempo máximo para esperar la siguiente petición con keep-alive)
SERVER_IDLE_TIMEOUT=60s

# Timeout de shutdown graceful
SERVER_SHUTDOWN_TIMEOUT=30s

# ============================================
# Configuración de AWS SQS
# ============================================
# Región de AWS donde está la cola SQS
SQS_REGION=us-east-1

# URL de la cola SQS (REQUERIDO si se usa el consumer SQS)
# Ejemplo: https://sqs.us-east-1.amazonaws.com/123456789012/my-queue
SQS_QUEUE_URL=

# Número máximo de mensajes a recibir por petición (1-10)
SQS_MAX_NUMBER_OF_MESSAGES=10

# Tiempo de espera para long polling en segundos (0-20)
SQS_WAIT_TIME_SECONDS=20

# Tiempo de visibilidad del mensaje en segundos
SQS_VISIBILITY_TIMEOUT=30

# ============================================
# Configuración de AWS (Credenciales)
# ============================================
# Las credenciales de AWS se pueden configurar de varias formas:
# 1. Variables de entorno (recomendado para desarrollo local):
#    AWS_ACCESS_KEY_ID=your-access-key
#    AWS_SECRET_ACCESS_KEY=your-secret-key
#    AWS_SESSION_TOKEN=your-session-token (opcional, solo para credenciales temporales)
#
# 2. Archivo de credenciales: ~/.aws/credentials
#
# 3. IAM Role (cuando se ejecuta en EC2/Lambda)
#
# 4. Variables de entorno del sistema
#
# Para desarrollo local, descomenta y configura:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ============================================
# Configuración de DynamoDB (si se necesita)
# ============================================
# Región de AWS para DynamoDB (puede ser diferente a SQS)
# AWS_REGION=us-east-1

# ============================================
# Notas
# ============================================
# - Si SQS_QUEUE_URL está vacío, el consumer SQS no se iniciará
# - Los valores por defecto se aplicarán si las variables no están definidas
# - Para producción, usa un gestor de secretos (AWS Secrets Manager, etc.)
# - Este archivo solo se carga cuando ENV=local o ENV está vacío

# ============================================
# Configuración de DynamoDB KVS
# ============================================
# Región de AWS donde está la tabla DynamoDB
KVS_REGION=us-east-1

# Nombre de la tabla DynamoDB (REQUERIDO)
KVS_TABLE_NAME=comparisons

# Nombre del atributo de clave primaria (opcional, default: "id")
KVS_KEY_ATTRIBUTE_NAME=id

# ============================================
# Notas
# ============================================
# - Si SQS_QUEUE_URL está vacío, el consumer SQS no se iniciará
# - Los valores por defecto se aplicarán si las variables no están definidas
# - Para producción, usa un gestor de secretos (AWS Secrets Manager, etc.)
